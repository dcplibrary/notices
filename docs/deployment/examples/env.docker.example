# Application
APP_NAME=Notices
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=base64:replace-with-real-key
TZ=America/Chicago

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=notices
DB_USERNAME=notices
DB_PASSWORD=notices
MYSQL_ROOT_PASSWORD=replace-me

# Cache / queue
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Optional reverse proxy
VIRTUAL_HOST=notices.dcplibrary.org
VIRTUAL_PORT=80
VIRTUAL_PROTO=http
LETSENCRYPT_HOST=notices.dcplibrary.org
LETSENCRYPT_EMAIL=admin@example.org

# Notices package integrations (fill with real values)
POLARIS_USE_FTP=true
POLARIS_FTP_HOST=
POLARIS_FTP_USERNAME=
POLARIS_FTP_PASSWORD=

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=
MICROSOFT_FOLDER_SHOUTBOMB=Shoutbomb_Reports
