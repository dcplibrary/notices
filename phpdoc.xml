<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://www.phpdoc.org"
    xsi:noNamespaceSchemaLocation="https://docs.phpdoc.org/latest/phpdoc.xsd"
>
    <title>dcplibrary/notices</title>

    <paths>
        <output>build/phpdoc</output>
        <cache>build/phpdoc-cache</cache>
    </paths>

    <version number="latest">
        <api format="php">
            <source dsn=".">
                <path>src</path>
            </source>

            <ignore hidden="true" symlinks="true">
                <path>src/Database/Migrations/**/*</path>
            </ignore>

            <extensions>
                <extension>php</extension>
            </extensions>

            <visibility>public</visibility>
            <default-package-name>Dcplibrary\Notices</default-package-name>
            <include-source>false</include-source>
        </api>
    </version>

    <template name="default"/>
</phpdocumentor>
